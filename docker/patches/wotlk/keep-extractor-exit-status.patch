index e49d84d..cc2c272 100644
--- a/contrib/extractor_scripts/MoveMapGen.sh
+++ b/contrib/extractor_scripts/MoveMapGen.sh
@@ -98,7 +98,16 @@ fi
 case "$1" in
  "maps" )
     createHeader
-    "$PREFIX"/MoveMapGen $PARAMS $OFFMESH $MMG_RES --buildGameObjects | tee -a "$DETAIL_LOG_FILE"
+    # cmangos-deploy: keep the exit status of `MoveMapGen` through `tee`, so a
+    # failed extraction stops the script.
+    file=$(mktemp)
+    { "$PREFIX"/MoveMapGen $PARAMS $OFFMESH $MMG_RES --buildGameObjects; echo $? > "$file"; } | tee -a "$DETAIL_LOG_FILE"
+    exit_code=$(cat "$file")
+    rm "$file"
+    if [ "$exit_code" -ne "0" ]; then
+      echo "$(date): Creating MoveMaps failed with errors. Aborting extraction. See the log file for more details."
+      exit "$exit_code"
+    fi
    ;;
  "offmesh" )
    echo "$(date): Recreate offmeshes from file $OFFMESH_FILE" | tee -a "$LOG_FILE"
